# Backend / database
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=verify-full
AUTH_JWT_SECRET=replace-with-at-least-32-characters

# When the API runs on a different origin (for example Render), set this on
# the frontend and the matching Vercel URL on the backend.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# Optional server-side override for pages rendered by Vercel.
BACKEND_URL=https://your-api.onrender.com
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Optional integrations
N8N_WEBHOOK_URL=
FUNDARMF_WEBHOOK_SECRET=
FUNDARMF_API_KEY=
FUNDARMF_ALLOWED_ORIGIN=
