# Backend / database
# Para PostgreSQL gerenciado DigitalOcean, mantenha SSL com compatibilidade libpq.
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=require&uselibpqcompat=true
AUTH_JWT_SECRET=replace-with-at-least-32-characters

# When the API runs on a different origin (for example Render), set this on
# the frontend and the matching Vercel URL on the backend.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# Backend URL used by Vercel server-rendered pages and the same-origin API rewrite.
BACKEND_URL=https://your-api.onrender.com
# Leave false/empty to use the Vercel rewrite, preserving the session cookie as same-origin.
NEXT_PUBLIC_API_DIRECT=false
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Optional integrations
N8N_WEBHOOK_URL=
FUNDARMF_WEBHOOK_SECRET=
FUNDARMF_API_KEY=
FUNDARMF_ALLOWED_ORIGIN=
